---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, groupByTags } from '../../utils/posts';
import { SITE } from '../../consts';
const base = import.meta.env.BASE_URL;
const tags = groupByTags(await getPosts());
---
<BaseLayout title="标签" description="全部标签">
  <div class="archive-page">
    <h1 class="page-title">标签</h1>
    <div class="tag-cloud big">
      {tags.map(([t, n]) => (
        <a class="tag-cloud-item" href={`${base}tags/${encodeURIComponent(t)}/`}>#{t}<sup>{n}</sup></a>
      ))}
    </div>
  </div>
</BaseLayout>
