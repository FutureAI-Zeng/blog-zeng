---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupByTags } from '../../utils/posts';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const tags = groupByTags(await getPosts());
  const all = await getPosts();
  return tags.map(([tag]) => ({
    params: { tag },
    props: { tag, posts: all.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`标签：${tag}`}>
  <div class="archive-page">
    <a class="back-link" href={`${base}tags`}>← 全部标签</a>
    <h1 class="page-title">#{tag}</h1>
    <p class="page-count">{posts.length} 篇文章</p>
    <ul class="post-card-list">
      {posts.map((post) => (
        <li><PostCard post={post} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>
