---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupByCategories } from '../../utils/posts';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const cats = groupByCategories(await getPosts());
  const all = await getPosts();
  return cats.map(([category]) => ({
    params: { category },
    props: { category, posts: all.filter((p) => (p.data.category || '未分类') === category) },
  }));
}

const { category, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`分类：${category}`}>
  <div class="archive-page">
    <a class="back-link" href={`${base}categories/`}>← 全部分类</a>
    <h1 class="page-title">{category}</h1>
    <p class="page-count">{posts.length} 篇文章</p>
    <ul class="post-card-list">
      {posts.map((post) => (
        <li><PostCard post={post} /></li>
      ))}
    </ul>
    {posts.length === 0 && <p class="empty-hint">该分类下还没有文章，敬请期待～</p>}
  </div>
</BaseLayout>
