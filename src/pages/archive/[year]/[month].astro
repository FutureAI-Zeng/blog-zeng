---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, groupByMonth, type Post } from '../../../utils/posts';
import { SITE } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return groupByMonth(posts).map(({ year, month, posts }) => ({
    params: { year: String(year), month: String(month) },
    props: { year: String(year), month: String(month), posts },
  }));
}

const { year, month, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const label = `${year} 年 ${Number(month)} 月`;
---
<BaseLayout title={`归档：${label}`}>
  <div class="archive-page">
    <a class="back-link" href={`${base}archive/`}>← 返回归档</a>
    <h1 class="page-title">{label}</h1>
    <p class="page-count">{posts.length} 篇文章</p>
    <ul class="post-card-list">
      {posts.map((post) => (
        <li><PostCard post={post} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>
