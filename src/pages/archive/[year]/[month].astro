---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, type Post } from '../../../utils/posts';
import { SITE } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const map = new Map<string, Post[]>();
  for (const p of posts) {
    const d = p.data.pubDate;
    const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
    if (!map.has(key)) map.set(key, []);
    map.get(key)!.push(p);
  }
  return [...map.entries()].map(([key, ps]) => {
    const [year, month] = key.split('-');
    return { params: { year, month }, props: { year, month, posts: ps } };
  });
}

const { year, month, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const label = `${year} 年 ${Number(month)} 月`;
---
<BaseLayout title={`归档：${label}`}>
  <div class="archive-page">
    <a class="back-link" href={`${base}archive`}>← 返回归档</a>
    <h1 class="page-title">{label}</h1>
    <p class="page-count">{posts.length} 篇文章</p>
    <ul class="post-card-list">
      {posts.map((post) => (
        <li><PostCard post={post} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>
