---
import { getPosts, groupByTags, groupByCategories, groupByMonth } from '../utils/posts';
import { SITE } from '../consts';
const base = import.meta.env.BASE_URL;
const posts = await getPosts();
const tags = groupByTags(posts);
const cats = groupByCategories(posts);
const months = groupByMonth(posts);
const total = posts.length;
const giscusEnabled = SITE.giscus.repo && SITE.giscus.repoId && SITE.giscus.categoryId;
const giscusRepo = SITE.giscus.repo;
---
<aside class="sidebar">
  <section class="widget">
    <h3 class="widget-title">分类统计</h3>
    <ul class="cat-cloud">
      {cats.map(([c, n]) => (
        <li>
          <a href={`${base}categories/${encodeURIComponent(c)}/`}>{c} <span>{n}</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="widget">
    <h3 class="widget-title">标签统计</h3>
    <div class="tag-cloud">
      {tags.slice(0, 20).map(([t, n]) => (
        <a class="tag-cloud-item" href={`${base}tags/${encodeURIComponent(t)}/`}>#{t}<sup>{n}</sup></a>
      ))}
    </div>
    {tags.length > 20 && (
      <>
        <button type="button" class="more-toggle" id="tag-more-btn" aria-expanded="false">
          <span class="more-label">更多标签</span> <span class="arrow">▾</span>
        </button>
        <div class="tag-cloud tag-cloud-more" id="tag-more-list" hidden>
          {tags.slice(20).map(([t, n]) => (
            <a class="tag-cloud-item" href={`${base}tags/${encodeURIComponent(t)}/`}>#{t}<sup>{n}</sup></a>
          ))}
        </div>
      </>
    )}
  </section>

  <section class="widget">
    <h3 class="widget-title">日期统计</h3>
    <ul class="date-cloud">
      {months.slice(0, 12).map((m) => (
        <li>
          <a href={`${base}archive/${m.year}/${m.month}/`}>
            {m.label} <span>{m.count}</span>
          </a>
        </li>
      ))}
    </ul>
    {months.length > 12 && (
      <>
        <button type="button" class="more-toggle" id="date-more-btn" aria-expanded="false">
          <span class="more-label">更多月份</span> <span class="arrow">▾</span>
        </button>
        <ul class="date-cloud date-cloud-more" id="date-more-list" hidden>
          {months.slice(12).map((m) => (
            <li>
              <a href={`${base}archive/${m.year}/${m.month}/`}>
                {m.label} <span>{m.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

  <section class="widget">
    <h3 class="widget-title">最新评论</h3>
    {giscusEnabled ? (
      <ul class="comment-list" id="latest-comments"></ul>
    ) : (
      <p class="widget-hint">启用 Giscus 后自动显示读者最新评论</p>
    )}
  </section>

  <section class="widget stat-widget">
    <p>共 <strong>{total}</strong> 篇文章</p>
  </section>
</aside>

{giscusEnabled && (
  <script is:inline define:vars={{ repo: giscusRepo, base }}>
    const el = document.getElementById('latest-comments');
    function esc(s){ return (s||'').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }
    fetch('https://giscus.app/api/discussions?repo=' + encodeURIComponent(repo))
      .then((r) => r.ok ? r.json() : Promise.reject())
      .then((data) => {
        const comments = [];
        (data || []).forEach((d) => {
          (d.comments || []).forEach((c) => {
            comments.push({ login: c.author.login, avatar: c.author.avatarUrl, body: c.body, url: c.url, title: d.title, createdAt: c.createdAt });
          });
        });
        comments.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
        const top = comments.slice(0, 5);
        if (!top.length) { el.innerHTML = '<li class="lc-empty">还没有评论，来抢沙发 🛋️</li>'; return; }
        el.innerHTML = top.map((c) => {
          const postHref = (c.title && c.title.startsWith('/')) ? base + c.title.slice(1) : c.url;
          return `<li class="comment-item">
            <img class="lc-avatar" src="${esc(c.avatar)}" alt="" loading="lazy" />
            <div class="lc-main">
              <a class="lc-author" href="${esc(c.url)}" target="_blank" rel="noopener">${esc(c.login)}</a>
              <span class="lc-post"> 在 <a href="${esc(postHref)}">${esc(c.title || '文章')}</a></span>
              <p class="lc-text">${esc(c.body).slice(0, 72)}</p>
            </div>
          </li>`;
        }).join('');
      })
      .catch(() => { el.innerHTML = '<li class="lc-empty">评论加载失败，请稍后重试</li>'; });
  </script>
)}

<style>
  .more-toggle {
    margin-top: 10px;
    width: 100%;
    border: none;
    background: transparent;
    color: var(--accent);
    font-size: .85rem;
    cursor: pointer;
    padding: 6px 0;
    border-top: 1px dashed var(--border);
  }
  .more-toggle:hover { text-decoration: underline; }
  .date-cloud-more { margin-top: 10px; }
  /* hidden 属性默认 display:none，但被 .date-cloud/.tag-cloud 的 display:flex 覆盖，
     这里强制让折叠列表在未展开时隐藏 */
  .date-cloud-more[hidden],
  .tag-cloud-more[hidden] { display: none !important; }
</style>

<script is:inline>
  (function () {
    function bindToggle(btnId, listId, moreText) {
      var btn = document.getElementById(btnId);
      var list = document.getElementById(listId);
      if (!btn || !list) return;
      btn.addEventListener('click', function () {
        var open = !list.hidden;
        list.hidden = open;
        btn.setAttribute('aria-expanded', String(!open));
        btn.querySelector('.more-label').textContent = open ? moreText : '收起';
        btn.querySelector('.arrow').textContent = open ? '▾' : '▴';
      });
    }
    bindToggle('date-more-btn', 'date-more-list', '更多月份');
    bindToggle('tag-more-btn', 'tag-more-list', '更多标签');
  })();
</script>
