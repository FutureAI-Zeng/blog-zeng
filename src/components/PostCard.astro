---
import FormattedDate from './FormattedDate.astro';
import { readingTime, type Post } from '../utils/posts';
import { SITE } from '../consts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const minutes = readingTime(post);
---
<article class="post-card">
  <div class="post-card-top">
    <a class="cat-badge" href={`${base}categories/${encodeURIComponent(post.data.category)}`}>
      {post.data.category}
    </a>
    <time datetime={post.data.pubDate.toISOString()}>
      {post.data.pubDate.toLocaleDateString('zh-CN')}
    </time>
  </div>
  <h2 class="post-card-title">
    <a href={`${base}posts/${post.id}`}>{post.data.title}</a>
  </h2>
  {post.data.description && <p class="post-card-desc">{post.data.description}</p>}
  <div class="post-card-meta">
    <span class="read-time">⏱ {minutes} 分钟</span>
    <ul class="tag-list">
      {post.data.tags.map((t) => (
        <li>
          <a class="tag-badge" href={`${base}tags/${encodeURIComponent(t)}`}>#{t}</a>
        </li>
      ))}
    </ul>
  </div>
</article>
